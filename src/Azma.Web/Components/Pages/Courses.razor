@page "/courses"
@inject CatalogService Catalog

<PageTitle>دوره‌های آموزشی</PageTitle>

<div class="page-header">
    <div class="container">
        <nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="/">خانه</a></li><li class="breadcrumb-item active">دوره‌ها</li></ol></nav>
        <h1>دوره‌های آموزشی</h1>
    </div>
</div>

<section class="section-sm">
    <div class="container">
        <form method="get" class="filter-bar mb-4" data-enhance-nav>
            <div class="row g-2 align-items-center">
                <div class="col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                        <input type="search" name="q" value="@Q" class="form-control" placeholder="جست‌وجوی عنوان دوره یا نام مدرس..." aria-label="جست‌وجو" />
                    </div>
                </div>
                <div class="col-md-4">
                    <select name="category" class="form-select" aria-label="دسته‌بندی">
                        <option value="">همه دسته‌بندی‌ها</option>
                        @foreach (var c in categories)
                        {
                            <option value="@c.Slug" selected="@(c.Slug == Category)">@c.Name</option>
                        }
                    </select>
                </div>
                @if (When is { } w && w != CourseTimeFilter.All) { <input type="hidden" name="when" value="@((int)w)" /> }
                <div class="col-md-3 d-grid"><button class="btn btn-primary" type="submit">اعمال فیلتر</button></div>
            </div>
            <div class="pill-tabs mt-3">
                @foreach (var (value, label) in timeFilters)
                {
                    <a href="@Nav.GetUriWithQueryParameters(new Dictionary<string, object?> { ["when"] = value == CourseTimeFilter.All ? null : (int)value, ["page"] = null })"
                       class="@((When ?? CourseTimeFilter.All) == value ? "active" : null)">@label</a>
                }
            </div>
        </form>

        @if (result is null || result.Items.Count == 0)
        {
            <div class="empty-state az-card">
                <i class="bi bi-journal-x"></i>
                دوره‌ای با این مشخصات یافت نشد.
                @if (!string.IsNullOrEmpty(Q) || !string.IsNullOrEmpty(Category) || When is not null) { <div class="mt-3"><a href="/courses" class="btn btn-light btn-sm">حذف فیلترها</a></div> }
            </div>
        }
        else
        {
            <p class="text-muted small mb-3">@Persian.Digits(result.TotalCount) دوره</p>
            <div class="row g-4">
                @foreach (var c in result.Items)
                {
                    <div class="col-sm-6 col-lg-4"><CourseCardView Course="c" /></div>
                }
            </div>
            <Pager Page="result.Page" TotalPages="result.TotalPages" />
        }
    </div>
</section>

@code {
    [Inject] private NavigationManager Nav { get; set; } = default!;
    [SupplyParameterFromQuery] private string? Q { get; set; }
    [SupplyParameterFromQuery] private string? Category { get; set; }
    [SupplyParameterFromQuery(Name = "when")] private int? WhenRaw { get; set; }
    private CourseTimeFilter? When => WhenRaw is >= 0 and <= 3 ? (CourseTimeFilter)WhenRaw.Value : null;
    [SupplyParameterFromQuery] private int? Page { get; set; }

    private PagedResult<CourseCard>? result;
    private IReadOnlyList<CategoryOption> categories = [];
    private static readonly (CourseTimeFilter, string)[] timeFilters =
    [
        (CourseTimeFilter.All, "همه"),
        (CourseTimeFilter.OpenForRegistration, "ثبت‌نام باز"),
        (CourseTimeFilter.Running, "در حال برگزاری"),
        (CourseTimeFilter.Upcoming, "آینده"),
    ];

    protected override async Task OnParametersSetAsync()
    {
        categories = await Catalog.GetCourseCategoriesAsync();
        var q = Q is { Length: > 100 } ? Q[..100] : Q;
        result = await Catalog.SearchCoursesAsync(new CourseFilter(q, Category, When ?? CourseTimeFilter.All, Math.Clamp(Page ?? 1, 1, 1000)));
    }
}
