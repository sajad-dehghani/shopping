@page "/"
@inject CatalogService Catalog

<PageTitle>@data?.Settings.SiteName - @data?.Settings.Tagline</PageTitle>
<HeadContent><meta name="description" content="@data?.Settings.HeroText" /></HeadContent>

@if (data is null) { return; }
@{
    var s = data.Settings;
    var cardEnabled = s.CardToCardEnabled && !string.IsNullOrWhiteSpace(s.CardNumber);
}

<!-- ===== Hero slider (managed in admin: /admin/slides) ===== -->
<section class="hero-slider-wrap">
    <div class="container">
        <div class="hero-slider" data-interval="@s.SliderIntervalSeconds" data-slides="@slides.Count" aria-roledescription="carousel" aria-label="معرفی @s.SiteName" tabindex="0">
            @for (var n = 0; n < slides.Count; n++)
            {
                var sl = slides[n];
                var first = n == 0;
                <div class="hero-slide @(first ? "is-active" : null)" role="group" aria-roledescription="slide" aria-label="@Persian.Digits(n + 1) از @Persian.Digits(slides.Count)" aria-hidden="@(first ? "false" : "true")">
                    <div class="hero-slide-bg @(string.IsNullOrEmpty(sl.Image) ? "no-img" : null)">
                        @if (!string.IsNullOrEmpty(sl.Image))
                        {
                            <img src="@sl.Image" alt="" width="1600" height="700" loading="@(first ? "eager" : "lazy")" fetchpriority="@(first ? "high" : "auto")" decoding="async" />
                        }
                    </div>
                    <div class="hero-slide-body">
                        <span class="eyebrow"><span class="dot"></span> @s.SiteName · خرید بدون نیاز به ثبت‌نام</span>
                        @if (first) { <h1>@sl.Title</h1> } else { <h2>@sl.Title</h2> }
                        @if (!string.IsNullOrEmpty(sl.Text)) { <p>@sl.Text</p> }
                        <div class="hero-cta">
                            @if (!string.IsNullOrEmpty(sl.ButtonText) && !string.IsNullOrEmpty(sl.ButtonUrl))
                            {
                                <a href="@sl.ButtonUrl" class="btn btn-gradient btn-lg" tabindex="@(first ? null : "-1")">@sl.ButtonText <i class="bi bi-arrow-left"></i></a>
                            }
                            else
                            {
                                if (s.CoursesEnabled) { <a href="/courses" class="btn btn-gradient btn-lg" tabindex="@(first ? null : "-1")"><i class="bi bi-journal-bookmark"></i> مشاهده دوره‌ها</a> }
                                if (s.ShopEnabled) { <a href="/products" class="btn @(s.CoursesEnabled ? "btn-light" : "btn-gradient") btn-lg" tabindex="@(first ? null : "-1")"><i class="bi bi-bag"></i> فروشگاه محصولات</a> }
                            }
                            <a href="/order/track" class="btn btn-light btn-lg d-none d-md-inline-flex" tabindex="@(first ? null : "-1")"><i class="bi bi-upc-scan"></i> پیگیری سفارش</a>
                        </div>
                    </div>
                </div>
            }
            <div class="hero-nav">
                <button type="button" class="hero-arrow" data-slide="prev" aria-label="اسلاید قبلی"><i class="bi bi-chevron-right"></i></button>
                <div class="hero-dots">
                    @for (var n = 0; n < slides.Count; n++)
                    {
                        <button type="button" class="@(n == 0 ? "is-active" : null)" aria-label="اسلاید @Persian.Digits(n + 1)"></button>
                    }
                </div>
                <button type="button" class="hero-arrow" data-slide="next" aria-label="اسلاید بعدی"><i class="bi bi-chevron-left"></i></button>
            </div>
        </div>
        <div class="trust-strip">
            <span><i class="bi bi-patch-check-fill"></i> بدون نیاز به ساخت حساب کاربری</span>
            <span><i class="bi bi-patch-check-fill"></i> کد رهگیری برای هر سفارش</span>
            <span><i class="bi bi-patch-check-fill"></i> پشتیبانی تیکتی</span>
        </div>
    </div>
</section>

<!-- ===== Stats ===== -->
<section class="stats-strip">
    <div class="container">
        <div class="stats-card reveal">
            @if (s.CoursesEnabled) { <div class="stat-item"><i class="bi bi-journal-bookmark"></i><span class="num" data-count="@data.Courses.Count">@Persian.Digits(data.Courses.Count)</span><span class="lbl">دوره فعال</span></div> }
            @if (s.ShopEnabled) { <div class="stat-item"><i class="bi bi-box-seam"></i><span class="num" data-count="@data.Products.Count">@Persian.Digits(data.Products.Count)</span><span class="lbl">محصول آموزشی</span></div> }
            <div class="stat-item"><i class="bi bi-upc-scan"></i><span class="num txt">آنلاین</span><span class="lbl">پیگیری با کد رهگیری</span></div>
            <div class="stat-item"><i class="bi bi-headset"></i><span class="num txt">تیکتی</span><span class="lbl">پشتیبانی سفارش‌ها</span></div>
        </div>
    </div>
</section>

<!-- ===== Infographic: how buying works ===== -->
<section class="section" id="how">
    <div class="container">
        <div class="section-head text-center reveal">
            <span class="eyebrow"><i class="bi bi-lightning-charge"></i> مسیر خرید در آزما</span>
            <h2 class="section-title">از انتخاب تا دریافت کد رهگیری، در ۴ قدم</h2>
            <p class="section-subtitle">بدون ساخت حساب کاربری؛ فقط نام و شماره موبایل کافی است.</p>
        </div>
        <div class="journey reveal">
            <div class="journey-line"><span></span></div>
            <div class="journey-step">
                <div class="journey-icon"><i class="bi bi-hand-index-thumb"></i></div>
                <div><h3>انتخاب @(s.CoursesEnabled && s.ShopEnabled ? "دوره یا محصول" : s.CoursesEnabled ? "دوره" : "محصول")</h3><p>@(s.CoursesEnabled && s.ShopEnabled ? "دوره یا محصول دلخواه" : s.CoursesEnabled ? "دوره دلخواه" : "محصول دلخواه") را انتخاب کنید.</p></div>
            </div>
            <div class="journey-step">
                <div class="journey-icon"><i class="bi bi-person-vcard"></i></div>
                <div><h3>ثبت نام و موبایل</h3><p>فقط نام، نام خانوادگی و شماره موبایل؛ بدون لاگین.</p></div>
            </div>
            <div class="journey-step">
                <div class="journey-icon"><i class="bi bi-credit-card-2-back"></i></div>
                <div><h3>پرداخت</h3><p>@(cardEnabled ? "درگاه بانکی آنلاین یا کارت به کارت و ارسال تصویر رسید." : "پرداخت امن از طریق درگاه بانکی.")</p></div>
            </div>
            <div class="journey-step">
                <div class="journey-icon"><i class="bi bi-upc-scan"></i></div>
                <div><h3>کد رهگیری و پشتیبانی</h3><p>با کد رهگیری، سفارش را پیگیری و در صورت نیاز تیکت ثبت کنید.</p></div>
            </div>
        </div>
    </div>
</section>

@if (s.CoursesEnabled && data.Courses.Count > 0)
{
    <section class="section section-white" id="courses">
        <div class="container">
            <div class="d-flex justify-content-between align-items-end flex-wrap gap-2 section-head reveal">
                <div>
                    <span class="eyebrow"><i class="bi bi-stars"></i> پیشنهاد ویژه</span>
                    <h2 class="section-title">دوره‌های فعال</h2>
                    <p class="section-subtitle">ظرفیت محدود؛ همین حالا ثبت‌نام کنید.</p>
                </div>
                <a href="/courses" class="btn btn-outline-primary">همه دوره‌ها <i class="bi bi-arrow-left"></i></a>
            </div>
            <div class="row g-4 scroller">
                @{ var i = 0; }
                @foreach (var c in data.Courses)
                {
                    <div class="col-sm-6 col-lg-4 reveal" style="--d:@((i++ % 3) * 0.08)s"><CourseCardView Course="c" /></div>
                }
            </div>
        </div>
    </section>
}

<!-- ===== Infographic: payment options ===== -->
<section class="section section-tint" id="payment">
    <div class="container">
        <div class="section-head text-center reveal">
            <span class="eyebrow"><i class="bi bi-shield-check"></i> پرداخت امن</span>
            <h2 class="section-title">روش پرداخت را خودتان انتخاب کنید</h2>
            <p class="section-subtitle">هر سفارش یک شماره سفارش و پس از تأیید پرداخت، یک کد رهگیری اختصاصی دارد.</p>
        </div>
        <div class="pay-info">
            <div class="pay-card featured reveal">
                <div class="pc-glow"></div>
                <div class="pc-head">
                    <span class="pc-icon"><i class="bi bi-lightning-charge-fill"></i></span>
                    <div><h3>درگاه پرداخت آنلاین</h3><span class="pc-tag">پیشنهادی · تأیید فوری</span></div>
                </div>
                <ul class="mini-steps">
                    <li><i class="bi bi-1-circle"></i> ثبت اطلاعات و انتقال به درگاه بانکی امن</li>
                    <li><i class="bi bi-2-circle"></i> پرداخت با همه کارت‌های عضو شتاب</li>
                    <li><i class="bi bi-3-circle"></i> صدور خودکار کد رهگیری بلافاصله پس از پرداخت</li>
                </ul>
                <div class="pc-meter">
                    <div class="row-lbl"><span>سرعت تأیید سفارش</span><span>آنی</span></div>
                    <div class="bar"><span style="--w:100%"></span></div>
                </div>
            </div>
            @if (cardEnabled)
            {
                <div class="pay-card reveal" style="--d:.12s">
                    <div class="pc-head">
                        <span class="pc-icon"><i class="bi bi-credit-card-2-front"></i></span>
                        <div><h3>کارت به کارت</h3><span class="pc-tag">ارسال تصویر رسید</span></div>
                    </div>
                    <ul class="mini-steps">
                        <li><i class="bi bi-1-circle"></i> واریز مبلغ سفارش به کارت فروشگاه</li>
                        <li><i class="bi bi-2-circle"></i> بارگذاری تصویر رسید همراه با نام و موبایل</li>
                        <li><i class="bi bi-3-circle"></i> صدور کد رهگیری پس از تأیید مدیر فروشگاه</li>
                    </ul>
                    <div class="pc-meter">
                        <div class="row-lbl"><span>سرعت تأیید سفارش</span><span>پس از بررسی رسید</span></div>
                        <div class="bar"><span style="--w:62%"></span></div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@if (s.ShopEnabled && data.Products.Count > 0)
{
    <section class="section">
        <div class="container">
            <div class="d-flex justify-content-between align-items-end flex-wrap gap-2 section-head reveal">
                <div>
                    <span class="eyebrow"><i class="bi bi-bag-heart"></i> فروشگاه</span>
                    <h2 class="section-title">محصولات</h2>
                    <p class="section-subtitle">کتاب‌ها و محصولات آموزشی قابل خرید آنلاین</p>
                </div>
                <a href="/products" class="btn btn-outline-primary">همه محصولات <i class="bi bi-arrow-left"></i></a>
            </div>
            <div class="row g-3 g-md-4 scroller products">
                @{ var j = 0; }
                @foreach (var p in data.Products.Take(4))
                {
                    <div class="col-6 col-lg-3 reveal" style="--d:@((j++ % 4) * 0.08)s"><ProductCardView Product="p" /></div>
                }
            </div>
        </div>
    </section>
}

@if (data.Features.Count > 0)
{
    <section class="section section-white">
        <div class="container">
            <div class="section-head text-center reveal">
                <h2 class="section-title">چرا @s.SiteName؟</h2>
                <p class="section-subtitle">آنچه خرید از ما را متفاوت می‌کند</p>
            </div>
            <div class="row g-3 g-md-4">
                @{ var k = 0; }
                @foreach (var f in data.Features)
                {
                    <div class="col-sm-6 col-lg-3 reveal" style="--d:@((k++ % 4) * 0.08)s">
                        <div class="feature">
                            <div class="icon"><i class="bi @f.Icon"></i></div>
                            <h3>@f.Title</h3>
                            @if (!string.IsNullOrEmpty(f.Description)) { <p>@f.Description</p> }
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}

@if (data.Instructors.Count > 0)
{
    <section class="section">
        <div class="container">
            <div class="section-head text-center reveal">
                <h2 class="section-title">مدرسین ما</h2>
                <p class="section-subtitle">متخصصانی که تجربه واقعی خود را با شما به اشتراک می‌گذارند</p>
            </div>
            <div class="row g-3 g-md-4 justify-content-center">
                @foreach (var ins in data.Instructors)
                {
                    <div class="col-6 col-md-4 col-lg-3 reveal">
                        <div class="az-card instructor">
                            @if (!string.IsNullOrEmpty(ins.PhotoPath)) { <img src="@ins.PhotoPath" alt="@ins.FullName" loading="lazy" width="96" height="96" /> }
                            else { <span class="avatar-fallback"><i class="bi bi-person"></i></span> }
                            <h3>@ins.FullName</h3>
                            @if (!string.IsNullOrEmpty(ins.Title)) { <p>@ins.Title</p> }
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}

<!-- ===== Tracking band ===== -->
<section class="section-sm pb-5">
    <div class="container">
        <div class="track-band reveal">
            <div class="row g-4 align-items-center">
                <div class="col-lg-5">
                    <h2 class="mb-2"><i class="bi bi-upc-scan ms-1"></i> سفارش خود را پیگیری کنید</h2>
                    <p class="m-0">کد رهگیری یا شماره سفارش را همراه با شماره موبایل وارد کنید. سؤالی دارید؟ <a href="/support" class="text-white fw-bold">تیکت ثبت کنید</a>.</p>
                </div>
                <div class="col-lg-7">
                    <form method="post" action="/order/track" class="track-form">
                        <AntiforgeryToken />
                        <input type="hidden" name="_handler" value="track" />
                        <input name="Input.Number" class="form-control ltr" placeholder="کد رهگیری یا شماره سفارش" required maxlength="30" aria-label="کد رهگیری یا شماره سفارش" />
                        <input name="Input.Mobile" type="tel" class="form-control" placeholder="شماره موبایل" required maxlength="20" inputmode="tel" aria-label="شماره موبایل" />
                        <button class="btn btn-gradient" type="submit"><i class="bi bi-search"></i> پیگیری</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@if (data.Faqs.Count > 0)
{
    <section class="section section-white" id="faq">
        <div class="container" style="max-width:820px">
            <div class="section-head text-center reveal">
                <h2 class="section-title">پرسش‌های متداول</h2>
                <p class="section-subtitle">پاسخ سوالات رایج درباره خرید، پرداخت و پیگیری</p>
            </div>
            <div class="faq reveal">
                @foreach (var q in data.Faqs)
                {
                    <details>
                        <summary>@q.Question</summary>
                        <div class="pre-line">@q.Answer</div>
                    </details>
                }
            </div>
        </div>
    </section>
}

<section class="section" id="contact">
    <div class="container">
        <div class="row g-4 g-lg-5">
            <div class="col-lg-5 reveal">
                <span class="eyebrow"><i class="bi bi-chat-dots"></i> در ارتباط باشیم</span>
                <h2 class="section-title">تماس با ما</h2>
                <p class="text-muted mb-4">برای مشاوره و اطلاعات بیشتر با ما در تماس باشید. برای پیگیری سفارش، از <a href="/support">بخش پشتیبانی</a> تیکت ثبت کنید.</p>
                <ContactInfo Settings="s" />
            </div>
            <div class="col-lg-7 reveal" style="--d:.1s">
                <div class="az-card az-card-lg p-4">
                    <h3 class="h5 mb-3">ارسال پیام</h3>
                    <ContactForm />
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private HomePageData? data;
    private List<SlideView> slides = [];

    protected override async Task OnInitializedAsync()
    {
        data = await Catalog.GetHomeAsync();
        var st = data.Settings;
        slides = data.Slides.Select(x => new SlideView(x.ImagePath, x.Title ?? st.HeroTitle ?? st.SiteName, x.Subtitle, x.ButtonText, x.ButtonUrl)).ToList();
        if (slides.Count == 0)
            slides.Add(new SlideView(st.HeroImagePath, st.HeroTitle ?? "دوره‌ها و محصولات آموزشی در چند کلیک", st.HeroText, null, null));
    }

    private sealed record SlideView(string? Image, string Title, string? Text, string? ButtonText, string? ButtonUrl);
}
