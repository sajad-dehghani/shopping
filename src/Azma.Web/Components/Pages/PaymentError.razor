@page "/payment/error"
@inject FlashMessages Flash

<PageTitle>خطا در پرداخت</PageTitle>
<section class="section">
    <div class="container text-center" style="max-width:560px">
        <div class="result-icon result-failed"><i class="bi bi-exclamation-triangle"></i></div>
        <h1 class="h4">مشکلی در بازگشت از درگاه پیش آمد</h1>
        <p class="text-muted">@(message ?? "اطلاعات پرداخت معتبر نیست.") اگر مبلغی از حساب شما کسر شده، با شماره سفارش از بخش پیگیری اقدام کنید یا با پشتیبانی تماس بگیرید.</p>
        <a href="/order/track" class="btn btn-primary mt-2">پیگیری سفارش</a>
    </div>
</section>

@code {
    private string? message;
    protected override void OnInitialized() => message = Flash.Take();
}
