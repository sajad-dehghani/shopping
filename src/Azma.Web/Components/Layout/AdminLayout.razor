@inherits LayoutComponentBase
@inject SiteSettingsService SettingsService
@inject ReceiptService ReceiptSvc
@inject TicketService TicketsSvc

<input type="checkbox" id="admin-nav-toggle" class="d-none" />
<div class="admin-shell">
    <aside class="admin-sidebar" id="admin-sidebar">
        <a href="/admin" class="admin-brand">
            <span class="brand-mark"><i class="bi bi-bag-heart-fill"></i></span>
            <span class="brand-text">@(site?.SiteName ?? "فروشگاه")<small>پنل مدیریت</small></span>
        </a>
        <nav aria-label="منوی مدیریت">
            <NavLink href="/admin" Match="NavLinkMatch.All"><i class="bi bi-grid-1x2"></i> <span>داشبورد</span></NavLink>

            <div class="nav-group">فروش و پرداخت</div>
            <NavLink href="/admin/orders"><i class="bi bi-receipt"></i> <span>سفارش‌ها</span></NavLink>
            <NavLink href="/admin/receipts"><i class="bi bi-credit-card-2-front"></i> <span>رسیدهای کارت به کارت</span>@Badge(pendingReceipts, "warn")</NavLink>
            <NavLink href="/admin/transactions"><i class="bi bi-arrow-left-right"></i> <span>تراکنش‌های درگاه</span></NavLink>
            <NavLink href="/admin/enrollments"><i class="bi bi-people"></i> <span>ثبت‌نام دوره‌ها</span>@Off(site?.CoursesEnabled == false)</NavLink>

            <div class="nav-group">پشتیبانی</div>
            <NavLink href="/admin/tickets"><i class="bi bi-life-preserver"></i> <span>تیکت‌ها</span>@Badge(openTickets, "info")</NavLink>
            <NavLink href="/admin/messages"><i class="bi bi-envelope"></i> <span>پیام‌های تماس</span></NavLink>

            <div class="nav-group">کاتالوگ</div>
            <NavLink href="/admin/courses"><i class="bi bi-journal-bookmark"></i> <span>دوره‌ها</span>@Off(site?.CoursesEnabled == false)</NavLink>
            <NavLink href="/admin/products"><i class="bi bi-box-seam"></i> <span>محصولات</span>@Off(site?.ShopEnabled == false)</NavLink>
            <NavLink href="/admin/categories"><i class="bi bi-tags"></i> <span>دسته‌بندی‌ها</span></NavLink>
            <NavLink href="/admin/instructors"><i class="bi bi-person-video3"></i> <span>مدرسین</span></NavLink>

            <div class="nav-group">ظاهر سایت</div>
            <NavLink href="/admin/slides"><i class="bi bi-images"></i> <span>اسلایدر صفحه اصلی</span></NavLink>
            <NavLink href="/admin/content"><i class="bi bi-layout-text-window"></i> <span>مزیت‌ها و پرسش‌ها</span></NavLink>

            <div class="nav-group">سیستم</div>
            <NavLink href="/admin/settings"><i class="bi bi-sliders"></i> <span>تنظیمات سایت</span></NavLink>
            <NavLink href="/admin/users"><i class="bi bi-shield-lock"></i> <span>مدیران</span></NavLink>
            <NavLink href="/admin/audit"><i class="bi bi-clock-history"></i> <span>گزارش عملیات</span></NavLink>
        </nav>
        <div class="admin-sidebar-foot">
            <a href="/" target="_blank" rel="noopener"><i class="bi bi-box-arrow-up-left"></i> <span>مشاهده سایت</span></a>
        </div>
    </aside>
    <label for="admin-nav-toggle" class="admin-backdrop" aria-hidden="true"></label>
    <div class="admin-main">
        <header class="admin-topbar">
            <div class="d-flex align-items-center gap-2">
                <label for="admin-nav-toggle" class="admin-icon-btn admin-mobile-toggle" aria-label="منو" role="button" tabindex="0"><i class="bi bi-list"></i></label>
                <span class="admin-topbar-title d-none d-md-inline">@(site?.SiteName) · مدیریت</span>
            </div>
            <div class="d-flex align-items-center gap-2">
                @if (pendingReceipts > 0)
                {
                    <a href="/admin/receipts" class="admin-pill warn" title="رسیدهای در انتظار بررسی"><i class="bi bi-hourglass-split"></i> <span class="d-none d-sm-inline">رسید در انتظار</span> @Persian.Digits(pendingReceipts)</a>
                }
                @if (openTickets > 0)
                {
                    <a href="/admin/tickets?status=0" class="admin-pill info" title="تیکت‌های بی‌پاسخ"><i class="bi bi-chat-left-dots"></i> <span class="d-none d-sm-inline">تیکت باز</span> @Persian.Digits(openTickets)</a>
                }
                <AuthorizeView>
                    <details class="admin-user">
                        <summary><span class="avatar">@Initial(context.User.Identity?.Name)</span> <span class="d-none d-md-inline small">@context.User.Identity?.Name</span> <i class="bi bi-chevron-down small"></i></summary>
                        <div class="admin-user-menu">
                            <a href="/Account/Manage/ChangePassword"><i class="bi bi-key"></i> تغییر رمز عبور</a>
                            <a href="/" target="_blank" rel="noopener"><i class="bi bi-box-arrow-up-left"></i> مشاهده سایت</a>
                            <form action="Account/Logout" method="post" class="m-0">
                                <AntiforgeryToken />
                                <button type="submit" class="text-danger"><i class="bi bi-box-arrow-left"></i> خروج از حساب</button>
                            </form>
                        </div>
                    </details>
                </AuthorizeView>
            </div>
        </header>
        <div class="admin-content">
            @Body
        </div>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    <i class="bi bi-exclamation-triangle-fill"></i>
    <span>خطای غیرمنتظره‌ای رخ داد.</span>
    <a href="." class="reload">بارگذاری مجدد صفحه</a>
    <button type="button" class="dismiss" aria-label="بستن">✕</button>
</div>

@code {
    private SiteSettings? site;
    private int pendingReceipts;
    private int openTickets;

    protected override async Task OnInitializedAsync()
    {
        site = await SettingsService.GetAsync();
        pendingReceipts = await ReceiptSvc.CountPendingAsync();
        openTickets = await TicketsSvc.CountOpenAsync();
    }

    private static string Initial(string? name) => string.IsNullOrEmpty(name) ? "?" : name[..1].ToUpperInvariant();

    private static RenderFragment Badge(int count, string kind) => count <= 0
        ? @<text></text>
        : @<span class="nav-badge @kind">@Persian.Digits(count)</span>;

    private static RenderFragment Off(bool off) => !off
        ? @<text></text>
        : @<span class="nav-badge off">غیرفعال</span>;
}
