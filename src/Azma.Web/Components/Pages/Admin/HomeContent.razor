@page "/admin/content"
@rendermode InteractiveServer
@inject ContentAdminService Content

<PageTitle>محتوای صفحه اصلی</PageTitle>
<AdminToast Message="@ToastMessage" IsError="ToastIsError" OnClose="ClearToast" />
<div class="admin-page-title"><h1>محتوای صفحه اصلی</h1></div>
<p class="text-muted small">اسلایدهای بالای صفحه در <a href="/admin/slides">اسلایدر صفحه اصلی</a> و اطلاعات تماس در <a href="/admin/settings">تنظیمات سایت</a> قابل ویرایش هستند.</p>

<div class="az-card p-3 mb-4">
    <h2 class="h6">مزیت‌های شرکت در دوره‌ها</h2>
    @foreach (var f in features)
    {
        <div class="row g-2 align-items-center border-bottom py-2">
            <div class="col-3 col-md-1"><IconPicker @bind-Value="f.Icon" /></div>
            <div class="col-9 col-md-5"><input class="form-control form-control-sm" @bind="f.Title" placeholder="عنوان" /></div>
            <div class="col-md-3"><input class="form-control form-control-sm" @bind="f.Description" placeholder="توضیح" /></div>
            <div class="col-4 col-md-1"><input type="number" class="form-control form-control-sm" @bind="f.SortOrder" title="ترتیب" /></div>
            <div class="col-4 col-md-1"><div class="form-check"><input class="form-check-input" type="checkbox" @bind="f.IsActive" title="فعال" /></div></div>
            <div class="col-4 col-md-1 text-nowrap">
                <button class="btn btn-sm btn-primary" @onclick="() => SaveAsync(f)"><i class="bi bi-check2"></i></button>
                @if (f.Id != 0) { <ConfirmButton OnConfirm="() => DeleteAsync<FeatureItem>(f.Id)"><i class="bi bi-trash"></i></ConfirmButton> }
            </div>
        </div>
    }
    <button class="btn btn-sm btn-light mt-2" @onclick="() => features.Add(new())"><i class="bi bi-plus"></i> افزودن مزیت</button>
</div>

<div class="az-card p-3">
    <h2 class="h6">پرسش‌های متداول</h2>
    @foreach (var q in faqs)
    {
        <div class="border rounded p-2 mb-2">
            <div class="row g-2">
                <div class="col-md-10"><input class="form-control form-control-sm mb-2" @bind="q.Question" placeholder="پرسش" /><textarea class="form-control form-control-sm" rows="2" @bind="q.Answer" placeholder="پاسخ"></textarea></div>
                <div class="col-md-2">
                    <input type="number" class="form-control form-control-sm mb-2" @bind="q.SortOrder" title="ترتیب" />
                    <div class="form-check mb-2"><input class="form-check-input" type="checkbox" id="fq@(q.GetHashCode())" @bind="q.IsActive" /><label class="form-check-label small" for="fq@(q.GetHashCode())">فعال</label></div>
                    <button class="btn btn-sm btn-primary" @onclick="() => SaveAsync(q)"><i class="bi bi-check2"></i></button>
                    @if (q.Id != 0) { <ConfirmButton OnConfirm="() => DeleteAsync<FaqItem>(q.Id)"><i class="bi bi-trash"></i></ConfirmButton> }
                </div>
            </div>
        </div>
    }
    <button class="btn btn-sm btn-light" @onclick="() => faqs.Add(new())"><i class="bi bi-plus"></i> افزودن پرسش</button>
</div>

@code {
    private List<FeatureItem> features = [];
    private List<FaqItem> faqs = [];

    protected override Task OnInitializedAsync() => LoadAsync();
    private async Task LoadAsync()
    {
        features = await Content.ListAsync<FeatureItem>();
        faqs = await Content.ListAsync<FaqItem>();
    }

    private async Task SaveAsync<T>(T entity) where T : Entity
    {
        var r = await Content.SaveAsync(entity, await GetActorAsync());
        if (r.Succeeded) { ShowOk("ذخیره شد."); await LoadAsync(); } else ShowError(r.Error);
    }

    private async Task DeleteAsync<T>(int id) where T : Entity
    {
        var r = await Content.DeleteAsync<T>(id, await GetActorAsync());
        if (r.Succeeded) { ShowOk("حذف شد."); await LoadAsync(); } else ShowError(r.Error);
    }
}
