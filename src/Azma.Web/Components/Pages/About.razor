@page "/about"
@inject SiteSettingsService SettingsService

<PageTitle>درباره ما</PageTitle>
<div class="page-header"><div class="container"><h1>درباره @settings?.SiteName</h1></div></div>
<section class="section-sm">
    <div class="container" style="max-width:860px">
        <div class="az-card p-4 p-md-5">
            <div class="pre-line fs-6">@(settings?.AboutText ?? "")</div>
        </div>
    </div>
</section>

@code {
    private SiteSettings? settings;
    protected override async Task OnInitializedAsync() => settings = await SettingsService.GetAsync();
}
