@{ var final = Money.FinalPrice(Price, DiscountPrice); }
<div class="text-start">
    @if (final < Price)
    {
        <span class="price-old">@Persian.Digits(Price)</span>
    }
    @if (final == 0)
    {
        <span class="price-free">رایگان</span>
    }
    else
    {
        <span class="price @PriceClass">@Persian.Digits(final) <small class="fw-normal text-muted">تومان</small></span>
    }
</div>

@code {
    [Parameter] public long Price { get; set; }
    [Parameter] public long? DiscountPrice { get; set; }
    [Parameter] public string? PriceClass { get; set; }
}
