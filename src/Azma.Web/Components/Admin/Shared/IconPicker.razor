@* Visual icon chooser (Bootstrap Icons). Binds the icon class name, e.g. "bi-award". *@
<div class="icon-picker">
    <button type="button" class="icon-picker-btn" @onclick="Toggle" aria-expanded="@open" title="انتخاب آیکون">
        <i class="bi @(string.IsNullOrEmpty(Value) ? "bi-question-circle" : Value)"></i>
        <i class="bi bi-chevron-down caret"></i>
    </button>
    @if (open)
    {
        <div class="icon-picker-backdrop" @onclick="() => open = false"></div>
        <div class="icon-picker-pop" role="dialog" aria-label="انتخاب آیکون">
            <input class="form-control form-control-sm mb-2" placeholder="جست‌وجو: پشتیبانی، کتاب، امنیت..." @bind="filter" @bind:event="oninput" />
            <div class="icon-grid">
                @foreach (var icon in Filtered)
                {
                    <button type="button" class="@(icon.Name == Value ? "active" : null)" title="@icon.Label" @onclick="() => PickAsync(icon.Name)">
                        <i class="bi @icon.Name"></i>
                    </button>
                }
                @if (!Filtered.Any()) { <div class="small text-muted p-2">آیکونی یافت نشد.</div> }
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    private bool open;
    private string? filter;

    private void Toggle() { open = !open; filter = null; }

    private async Task PickAsync(string name)
    {
        open = false;
        await ValueChanged.InvokeAsync(name);
    }

    private IEnumerable<IconOption> Filtered => string.IsNullOrWhiteSpace(filter)
        ? Icons
        : Icons.Where(i => i.Label.Contains(filter.Trim()) || i.Name.Contains(filter.Trim(), StringComparison.OrdinalIgnoreCase));

    private sealed record IconOption(string Name, string Label);

