@inherits LayoutComponentBase
@inject SiteSettingsService SettingsService

@{ var s = settings ?? new SiteSettings(); }

<div class="site-topbar d-none d-md-block">
    <div class="container d-flex justify-content-between align-items-center py-1">
        <div class="d-flex gap-4">
            @if (!string.IsNullOrEmpty(s.Phone))
            {
                <span><i class="bi bi-telephone ms-1"></i> <a href="tel:@s.Phone" class="ltr">@Persian.Digits(s.Phone)</a></span>
            }
            @if (!string.IsNullOrEmpty(s.SupportMobile))
            {
                <span><i class="bi bi-phone ms-1"></i> پشتیبانی: <a href="tel:@s.SupportMobile" class="ltr">@Persian.Digits(s.SupportMobile)</a></span>
            }
        </div>
        @if (!string.IsNullOrEmpty(s.WorkingHours))
        {
            <span><i class="bi bi-clock ms-1"></i> @s.WorkingHours</span>
        }
    </div>
</div>

<header class="site-header">
    <div class="container d-flex align-items-center justify-content-between position-relative">
        <a href="/" class="brand" aria-label="@s.SiteName">
            @if (!string.IsNullOrEmpty(s.LogoPath))
            {
                <img src="@s.LogoPath" alt="@s.SiteName" />
            }
            else
            {
                <span class="brand-mark"><i class="bi bi-mortarboard"></i></span>
            }
            <span>@s.SiteName</span>
        </a>

        <nav class="main-nav d-none d-lg-flex gap-1" aria-label="منوی اصلی">
            <NavLink href="/" Match="NavLinkMatch.All">خانه</NavLink>
            <NavLink href="/courses">دوره‌ها</NavLink>
            <NavLink href="/products">محصولات</NavLink>
            <NavLink href="/about">درباره ما</NavLink>
            <NavLink href="/contact">تماس با ما</NavLink>
        </nav>

        <div class="d-none d-lg-block">
            <a href="/courses" class="btn btn-primary"><i class="bi bi-journal-check ms-1"></i> ثبت‌نام در دوره‌ها</a>
        </div>

        <details class="mobile-nav d-lg-none">
            <summary class="btn btn-light" aria-label="منو"><i class="bi bi-list fs-5"></i></summary>
            <div class="mobile-nav-panel">
                <a href="/">خانه</a>
                <a href="/courses">دوره‌ها</a>
                <a href="/products">محصولات</a>
                <a href="/about">درباره ما</a>
                <a href="/contact">تماس با ما</a>
                @if (!string.IsNullOrEmpty(s.SupportMobile))
                {
                    <a href="tel:@s.SupportMobile"><i class="bi bi-phone ms-1"></i> پشتیبانی: <span class="ltr">@Persian.Digits(s.SupportMobile)</span></a>
                }
            </div>
        </details>
    </div>
</header>

<main id="main">
    @Body
</main>

<footer class="site-footer">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-4">
                <h3>@s.SiteName</h3>
                <p class="mb-3">@(s.Tagline ?? s.AboutText)</p>
                <div class="social">
                    <SocialLink Url="@s.Instagram" Icon="bi-instagram" Title="اینستاگرام" />
                    <SocialLink Url="@s.Telegram" Icon="bi-telegram" Title="تلگرام" />
                    <SocialLink Url="@s.WhatsApp" Icon="bi-whatsapp" Title="واتس‌اپ" />
                    <SocialLink Url="@s.LinkedIn" Icon="bi-linkedin" Title="لینکدین" />
                    <SocialLink Url="@s.Aparat" Icon="bi-play-btn" Title="آپارات" />
                </div>
            </div>
            <div class="col-6 col-lg-2">
                <h3>دسترسی سریع</h3>
                <ul>
                    <li><a href="/courses">دوره‌ها</a></li>
                    <li><a href="/products">محصولات</a></li>
                    <li><a href="/about">درباره ما</a></li>
                    <li><a href="/contact">تماس با ما</a></li>
                </ul>
            </div>
            <div class="col-6 col-lg-3">
                <h3>راهنما</h3>
                <ul>
                    <li><a href="/#faq">پرسش‌های متداول</a></li>
                    <li><a href="/order/track">پیگیری سفارش</a></li>
                    <li><a href="/terms">قوانین و مقررات</a></li>
                </ul>
            </div>
            <div class="col-lg-3">
                <h3>تماس</h3>
                <ul>
                    @if (!string.IsNullOrEmpty(s.Address)) { <li><i class="bi bi-geo-alt ms-1"></i> @s.Address</li> }
                    @if (!string.IsNullOrEmpty(s.Phone)) { <li><i class="bi bi-telephone ms-1"></i> <a href="tel:@s.Phone" class="ltr">@Persian.Digits(s.Phone)</a></li> }
                    @if (!string.IsNullOrEmpty(s.Email)) { <li><i class="bi bi-envelope ms-1"></i> <a href="mailto:@s.Email">@s.Email</a></li> }
                </ul>
                @if (!string.IsNullOrWhiteSpace(s.EnamadHtmlCode))
                {
                    <div class="mt-3 bg-white d-inline-block rounded p-1">@((MarkupString)s.EnamadHtmlCode)</div>
                }
            </div>
        </div>
        <div class="footer-bottom d-flex flex-wrap justify-content-between gap-2">
            <span>© @Persian.Digits(Persian.ToJalali(DateTime.UtcNow)[..4]) @s.SiteName — @(s.FooterText ?? "تمامی حقوق محفوظ است.")</span>
        </div>
    </div>
</footer>

<div id="blazor-error-ui" data-nosnippet>
    خطای غیرمنتظره‌ای رخ داد. <a href="." class="reload">بارگذاری مجدد</a>
    <span class="dismiss">✕</span>
</div>

@code {
    private SiteSettings? settings;

    protected override async Task OnInitializedAsync() => settings = await SettingsService.GetAsync();
}
