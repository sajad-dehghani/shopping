@page "/terms"
@inject SiteSettingsService SettingsService

<PageTitle>قوانین و مقررات - @s.SiteName</PageTitle>
<HeadContent><meta name="description" content="قوانین و مقررات خرید، پرداخت، انصراف و بازگشت وجه و حریم خصوصی @s.SiteName" /></HeadContent>

<div class="page-header">
    <div class="container">
        <nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="/">خانه</a></li><li class="breadcrumb-item active">قوانین و مقررات</li></ol></nav>
        <h1>قوانین و مقررات</h1>
        <p>استفاده از خدمات و ثبت سفارش در @s.SiteName به معنای پذیرش کامل این قوانین است.</p>
    </div>
</div>

<section class="section-sm">
    <div class="container" style="max-width:1120px">
        @if (!string.IsNullOrWhiteSpace(s.TermsText))
        {
            @* Custom text entered by the site admin replaces the default terms. *@
            <div class="az-card p-4 p-md-5"><div class="pre-line terms-body">@s.TermsText</div></div>
        }
        else
        {
            <div class="terms-layout">
                <aside class="az-card terms-toc" aria-label="فهرست مطالب">
                    <h2>فهرست</h2>
                    <ol>
                        @foreach (var (id, title, _) in Sections) { <li><a href="/terms#@id">@title</a></li> }
                    </ol>
                </aside>
                <div class="az-card p-4 p-md-5 terms-body">
                    <section id="general">
                        <h2><i class="bi bi-info-circle"></i> کلیات و پذیرش قوانین</h2>
                        <p>وب‌سایت «@s.SiteName» (در این متن «فروشگاه») بستری برای ثبت‌نام در دوره‌های آموزشی و خرید محصولات است. کاربر با ثبت سفارش، پرداخت وجه یا ارسال تیکت، این قوانین را مطالعه کرده و پذیرفته است. این قوانین تابع قوانین جمهوری اسلامی ایران از جمله قانون تجارت الکترونیکی و قانون حمایت از حقوق مصرف‌کنندگان است و در صورت تعارض، مقررات قانونی مقدم خواهد بود.</p>
                    </section>

                    <section id="order">
                        <h2><i class="bi bi-person-vcard"></i> ثبت سفارش و اطلاعات خریدار</h2>
                        <ul>
                            <li>خرید بدون ساخت حساب کاربری و فقط با ثبت نام، نام خانوادگی و شماره موبایل انجام می‌شود. مسئولیت صحت اطلاعات واردشده بر عهده خریدار است.</li>
                            <li>شماره موبایل، کلید پیگیری سفارش و تیکت‌های شماست؛ آن را درست وارد کنید و کد رهگیری را در اختیار دیگران قرار ندهید.</li>
                            <li>ثبت سفارش به معنای قطعی‌شدن آن نیست؛ سفارش تنها پس از تأیید پرداخت، نهایی و کد رهگیری صادر می‌شود.</li>
                            <li>فروشگاه می‌تواند سفارش‌هایی را که با اطلاعات نادرست، به‌صورت غیرمتعارف یا با هدف سوءاستفاده ثبت شده‌اند لغو کند و وجه دریافتی را بازگرداند.</li>
                        </ul>
                    </section>

                    <section id="payment">
                        <h2><i class="bi bi-credit-card-2-front"></i> قیمت‌ها و پرداخت</h2>
                        <ul>
                            <li>تمامی قیمت‌ها به تومان است. مبلغ نهایی همان مبلغی است که پیش از پرداخت در صفحه سفارش نمایش داده می‌شود.</li>
                            <li><b>پرداخت آنلاین:</b> از طریق درگاه بانکی معتبر و عضو شبکه شتاب انجام می‌شود. اطلاعات کارت بانکی شما فقط در صفحه امن بانک وارد می‌شود و فروشگاه به آن دسترسی ندارد.</li>
                            <li><b>کارت به کارت:</b> خریدار مبلغ سفارش را به کارت اعلام‌شده در صفحه سفارش واریز و تصویر رسید را همراه با نام و شماره موبایل ارسال می‌کند. کد رهگیری پس از بررسی و تأیید رسید توسط مدیر فروشگاه صادر می‌شود. در این مدت ظرفیت دوره برای شما رزرو می‌ماند.</li>
                            <li>ارسال رسید نادرست، تکراری یا جعلی موجب رد رسید و لغو سفارش می‌شود و فروشگاه حق پیگیری قانونی آن را محفوظ می‌دارد.</li>
                            <li>اگر مبلغی از حساب شما کسر شد ولی پرداخت در سایت ناموفق اعلام شد، طبق مقررات شبکه بانکی معمولاً ظرف ۷۲ ساعت به حساب شما بازمی‌گردد. در غیر این صورت با شماره سفارش تیکت ثبت کنید.</li>
                        </ul>
                    </section>

                    <section id="tracking">
                        <h2><i class="bi bi-upc-scan"></i> کد رهگیری و پیگیری سفارش</h2>
                        <ul>
                            <li>برای هر سفارش موفق یک کد رهگیری اختصاصی صادر می‌شود که از بخش «پیگیری سفارش» همراه با شماره موبایل قابل استفاده است.</li>
                            <li>اگر کد رهگیری را فراموش کرده‌اید، از بخش <a href="/support">پشتیبانی</a> گزینه «کد رهگیری را فراموش کرده‌ام» را انتخاب کنید. کد فقط به همان شماره موبایلی که هنگام خرید ثبت شده اعلام می‌شود.</li>
                        </ul>
                    </section>

                    @if (s.CoursesEnabled)
                    {
                        <section id="courses">
                            <h2><i class="bi bi-journal-bookmark"></i> دوره‌های آموزشی</h2>
                            <ul>
                                <li>ثبت‌نام در دوره پس از پرداخت موفق قطعی می‌شود. ظرفیت دوره‌ها محدود است و رزرو ظرفیت برای سفارش‌های پرداخت‌نشده موقت است.</li>
                                <li>زمان، مکان یا شیوه برگزاری (حضوری/آنلاین) ممکن است به دلایل ضروری تغییر کند؛ در این صورت از طریق شماره موبایل ثبت‌شده اطلاع‌رسانی می‌شود. اگر زمان جدید برای شما مناسب نباشد، می‌توانید درخواست بازگشت کامل وجه دهید.</li>
                                <li>در صورت لغو دوره از سوی فروشگاه، کل مبلغ پرداختی بازگردانده می‌شود.</li>
                                <li>شرایط اختصاصی هر دوره (پیش‌نیاز، گواهی، مهلت انصراف) در صفحه همان دوره درج می‌شود و بخشی از این قوانین است.</li>
                                <li>حق شرکت در دوره شخصی است و بدون هماهنگی با پشتیبانی قابل واگذاری به شخص دیگر نیست.</li>
                            </ul>
                        </section>
                    }

                    @if (s.ShopEnabled)
                    {
                        <section id="shipping">
                            <h2><i class="bi bi-truck"></i> محصولات، ارسال و تحویل</h2>
                            <ul>
                                <li>تصاویر و توضیحات محصولات با دقت تهیه شده‌اند؛ با این حال ممکن است تفاوت جزئی در رنگ یا بسته‌بندی وجود داشته باشد.</li>
                                <li>محصولات فیزیکی پس از تأیید پرداخت به نشانی واردشده توسط خریدار ارسال می‌شوند. مسئولیت صحت نشانی و کد پستی بر عهده خریدار است.</li>
                                <li>زمان تحویل به شیوه ارسال و مقصد بستگی دارد. تأخیر ناشی از شرکت حمل یا شرایط خارج از کنترل فروشگاه، تعهدی برای فروشگاه ایجاد نمی‌کند، اما پیگیری آن از طریق تیکت انجام می‌شود.</li>
                                <li>لطفاً هنگام تحویل، سلامت بسته را بررسی و در صورت آسیب‌دیدگی، موضوع را حداکثر ظرف ۲۴ ساعت همراه با تصویر از طریق تیکت اطلاع دهید.</li>
                            </ul>
                        </section>
                    }

                    <section id="refund">
                        <h2><i class="bi bi-arrow-counterclockwise"></i> انصراف، مرجوعی و بازگشت وجه</h2>
                        <ul>
                            @if (s.ShopEnabled)
                            {
                                <li><b>محصولات فیزیکی:</b> مطابق قانون تجارت الکترونیکی، خریدار می‌تواند تا ۷ روز کاری پس از تحویل، بدون ذکر دلیل از خرید انصراف دهد؛ به شرط آنکه کالا استفاده نشده، سالم و در بسته‌بندی اصلی باشد. هزینه بازگرداندن کالا (جز در موارد معیوب یا مغایر بودن با سفارش) بر عهده خریدار است.</li>
                                <li>کالای معیوب یا مغایر با مشخصات اعلام‌شده، با هزینه فروشگاه تعویض یا وجه آن به‌طور کامل بازگردانده می‌شود.</li>
                                <li>محصولات دیجیتال یا فایل‌هایی که پس از خرید در اختیار خریدار قرار گرفته‌اند، به دلیل ماهیت قابل کپی بودن، پس از تحویل قابل انصراف نیستند؛ مگر آنکه معیوب یا مغایر با توضیحات باشند.</li>
                            }
                            @if (s.CoursesEnabled)
                            {
                                <li><b>دوره‌ها:</b> انصراف پیش از شروع دوره امکان‌پذیر است و وجه پس از کسر هزینه‌های بانکی و اداری اعلام‌شده در صفحه دوره (در صورت وجود) بازگردانده می‌شود. پس از شروع دوره، بازگشت وجه تابع شرایط مندرج در صفحه همان دوره است.</li>
                            }
                            <li>درخواست انصراف یا بازگشت وجه را با ثبت تیکت و ذکر کد رهگیری ارسال کنید. وجه تأییدشده حداکثر ظرف ۷ روز کاری به شماره کارت یا شبای متعلق به خریدار (به نام همان شخص) بازگردانده می‌شود.</li>
                        </ul>
                    </section>

                    <section id="ip">
                        <h2><i class="bi bi-c-circle"></i> مالکیت فکری</h2>
                        <p>تمامی محتوای سایت و دوره‌ها شامل متن، فیلم، جزوه، تصاویر، لوگو و طراحی متعلق به @s.SiteName یا صاحبان قانونی آن است. ضبط، تکثیر، فروش، انتشار عمومی یا در اختیار قراردادن محتوای آموزشی به دیگران بدون اجازه کتبی ممنوع است و قابل پیگرد قانونی خواهد بود. استفاده شخصی و آموزشی خریدار مجاز است.</p>
                    </section>

                    <section id="privacy">
                        <h2><i class="bi bi-shield-lock"></i> حریم خصوصی و حفاظت از اطلاعات</h2>
                        <ul>
                            <li>اطلاعاتی که دریافت می‌کنیم محدود به موارد لازم برای انجام سفارش است: نام و نام خانوادگی، شماره موبایل، و در صورت نیاز ایمیل، نشانی پستی، اطلاعات فرم ثبت‌نام دوره و تصویر رسید پرداخت.</li>
                            <li>این اطلاعات فقط برای پردازش سفارش، برگزاری دوره، ارسال محصول، پشتیبانی و اطلاع‌رسانی مرتبط با همان سفارش استفاده می‌شود و به هیچ شخص ثالثی فروخته یا اجاره داده نمی‌شود.</li>
                            <li>اطلاعات فقط در موارد ضروری و به میزان لازم در اختیار شرکت پست/حمل، درگاه پرداخت، یا مراجع قانونی (در صورت درخواست رسمی) قرار می‌گیرد.</li>
                            <li>تصاویر رسید در فضای خصوصی ذخیره می‌شوند و فقط مدیران فروشگاه به آن دسترسی دارند. ارتباط با سایت از طریق پروتکل امن (HTTPS) انجام می‌شود.</li>
                            <li>اطلاعات کارت بانکی، رمز دوم و CVV2 هرگز توسط فروشگاه دریافت یا ذخیره نمی‌شود. فروشگاه هیچ‌گاه از طریق تماس یا پیامک، رمز کارت یا کد تأیید بانکی شما را درخواست نمی‌کند.</li>
                            <li>می‌توانید با ثبت تیکت، درخواست اصلاح یا حذف اطلاعات شخصی خود را ارسال کنید؛ مگر اطلاعاتی که نگهداری آن طبق قانون (مانند سوابق مالی) الزامی است.</li>
                            <li>سایت فقط از کوکی‌های ضروری برای امنیت فرم‌ها و عملکرد صحیح استفاده می‌کند و برای ردیابی تبلیغاتی از کوکی استفاده نمی‌شود.</li>
                        </ul>
                    </section>

                    <section id="support">
                        <h2><i class="bi bi-headset"></i> پشتیبانی و تیکت</h2>
                        <ul>
                            <li>پیگیری سفارش‌ها از طریق <a href="/support">سامانه تیکت</a> انجام می‌شود. پاسخ تیکت‌ها در ساعات کاری @(string.IsNullOrEmpty(s.WorkingHours) ? "" : $"({s.WorkingHours}) ")و معمولاً ظرف یک روز کاری ارسال می‌شود.</li>
                            <li>لطفاً در تیکت از ارسال اطلاعات محرمانه بانکی (رمز کارت، CVV2) خودداری کنید.</li>
                            <li>استفاده از الفاظ نامناسب یا ارسال پیام‌های مکرر و بی‌ارتباط ممکن است موجب بسته‌شدن تیکت شود.</li>
                        </ul>
                    </section>

                    <section id="obligations">
                        <h2><i class="bi bi-person-check"></i> تعهدات کاربر</h2>
                        <ul>
                            <li>هرگونه تلاش برای اختلال در عملکرد سایت، دسترسی غیرمجاز، ثبت سفارش با هویت دیگران یا استفاده از کارت بانکی متعلق به دیگران بدون اجازه ممنوع است.</li>
                            <li>کاربر متعهد است از خدمات سایت فقط برای مقاصد قانونی استفاده کند.</li>
                        </ul>
                    </section>

                    <section id="liability">
                        <h2><i class="bi bi-exclamation-diamond"></i> محدودیت مسئولیت و قوه قاهره</h2>
                        <p>فروشگاه تلاش می‌کند خدمات را به‌صورت پیوسته و بدون خطا ارائه دهد، اما در صورت بروز قطعی اینترنت، اختلال در شبکه بانکی، بلایای طبیعی، تصمیمات حاکمیتی یا سایر موارد قوه قاهره که خارج از کنترل فروشگاه است، مسئولیتی در قبال تأخیر یا عدم انجام تعهدات نخواهد داشت. در این شرایط، تعهدات پس از رفع مانع انجام یا وجه سفارش بازگردانده می‌شود. مسئولیت فروشگاه در هر حال حداکثر به میزان مبلغ پرداخت‌شده برای همان سفارش است.</p>
                    </section>

                    <section id="disputes">
                        <h2><i class="bi bi-bank"></i> حل اختلاف</h2>
                        <p>در صورت بروز هرگونه اختلاف، ابتدا موضوع از طریق تیکت پشتیبانی و به‌صورت مسالمت‌آمیز پیگیری می‌شود. در صورت عدم حصول نتیجه، خریدار می‌تواند از طریق مراجع رسمی رسیدگی به شکایات کسب‌وکارهای اینترنتی یا مراجع صالح قضایی جمهوری اسلامی ایران اقدام کند.</p>
                    </section>

                    <section id="changes">
                        <h2><i class="bi bi-arrow-repeat"></i> تغییرات قوانین</h2>
                        <p>فروشگاه ممکن است این قوانین را برای بهبود خدمات یا انطباق با مقررات به‌روزرسانی کند. نسخه به‌روز همواره در همین صفحه در دسترس است و برای سفارش‌هایی که پس از انتشار ثبت می‌شوند اعمال می‌شود. سفارش‌های قبلی تابع قوانین زمان ثبت خود هستند.</p>
                    </section>

                    <section id="contact">
                        <h2><i class="bi bi-telephone"></i> راه‌های ارتباطی</h2>
                        <ul>
                            <li>ثبت تیکت: <a href="/support">بخش پشتیبانی</a></li>
                            @if (!string.IsNullOrEmpty(s.Phone)) { <li>تلفن: <a href="tel:@s.Phone" class="ltr d-inline-block">@Persian.Digits(s.Phone)</a></li> }
                            @if (!string.IsNullOrEmpty(s.Email)) { <li>ایمیل: <a href="mailto:@s.Email">@s.Email</a></li> }
                            @if (!string.IsNullOrEmpty(s.Address)) { <li>نشانی: @s.Address</li> }
                        </ul>
                        <div class="terms-note mt-3"><i class="bi bi-lightbulb ms-1"></i> نکته امنیتی: فقط از نشانی رسمی همین سایت خرید کنید و پیش از پرداخت، نشانی صفحه درگاه بانکی را بررسی کنید.</div>
                    </section>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private SiteSettings s = new();

    private IEnumerable<(string Id, string Title, bool Show)> Sections => new (string, string, bool)[]
    {
        ("general", "کلیات", true),
        ("order", "ثبت سفارش", true),
        ("payment", "قیمت و پرداخت", true),
        ("tracking", "کد رهگیری", true),
        ("courses", "دوره‌ها", s.CoursesEnabled),
        ("shipping", "ارسال و تحویل", s.ShopEnabled),
        ("refund", "انصراف و بازگشت وجه", true),
        ("ip", "مالکیت فکری", true),
        ("privacy", "حریم خصوصی", true),
        ("support", "پشتیبانی", true),
        ("obligations", "تعهدات کاربر", true),
        ("liability", "محدودیت مسئولیت", true),
        ("disputes", "حل اختلاف", true),
        ("changes", "تغییرات قوانین", true),
        ("contact", "تماس", true),
    }.Where(x => x.Item3);

    protected override async Task OnInitializedAsync() => s = await SettingsService.GetAsync();
}
