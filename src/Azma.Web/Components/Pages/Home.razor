@page "/"
@inject CatalogService Catalog

<PageTitle>@data?.Settings.SiteName - @data?.Settings.Tagline</PageTitle>
<HeadContent><meta name="description" content="@data?.Settings.HeroText" /></HeadContent>

@if (data is null) { return; }
@{ var s = data.Settings; }

<section class="hero">
    <div class="container">
        <div class="row align-items-center g-4 g-lg-5">
            <div class="col-lg-6">
                <span class="eyebrow">@s.SiteName</span>
                <h1>@(s.HeroTitle ?? s.SiteName)</h1>
                @if (!string.IsNullOrEmpty(s.HeroText)) { <p class="lead mt-3">@s.HeroText</p> }
                <div class="d-flex flex-wrap gap-2 mt-4">
                    <a href="/courses" class="btn btn-primary btn-lg">مشاهده دوره‌ها</a>
                    <a href="#contact" class="btn btn-light btn-lg">مشاوره و تماس</a>
                </div>
                <div class="hero-stats">
                    <div><strong>@Persian.Digits(data.Courses.Count)+</strong><span>دوره فعال</span></div>
                    @if (data.Instructors.Count > 0) { <div><strong>@Persian.Digits(data.Instructors.Count)</strong><span>مدرس متخصص</span></div> }
                    <div><strong>آنلاین</strong><span>ثبت‌نام و پرداخت</span></div>
                </div>
            </div>
            @if (!string.IsNullOrEmpty(s.HeroImagePath))
            {
                <div class="col-lg-6 d-none d-md-block">
                    <div class="hero-figure"><img src="@s.HeroImagePath" alt="" width="1200" height="900" fetchpriority="high" /></div>
                </div>
            }
        </div>
    </div>
</section>

@if (data.Courses.Count > 0)
{
    <section class="section" id="courses">
        <div class="container">
            <div class="d-flex justify-content-between align-items-end flex-wrap gap-2 mb-4">
                <div>
                    <h2 class="section-title">دوره‌های فعال و ویژه</h2>
                    <p class="text-muted m-0">ظرفیت محدود؛ همین حالا ثبت‌نام کنید.</p>
                </div>
                <a href="/courses" class="btn btn-outline-primary">همه دوره‌ها <i class="bi bi-arrow-left"></i></a>
            </div>
            <div class="row g-4">
                @foreach (var c in data.Courses)
                {
                    <div class="col-sm-6 col-lg-4"><CourseCardView Course="c" /></div>
                }
            </div>
        </div>
    </section>
}

@if (data.Products.Count > 0)
{
    <section class="section section-white">
        <div class="container">
            <div class="d-flex justify-content-between align-items-end flex-wrap gap-2 mb-4">
                <div>
                    <h2 class="section-title">محصولات</h2>
                    <p class="text-muted m-0">کتاب‌ها و محصولات آموزشی قابل خرید آنلاین</p>
                </div>
                <a href="/products" class="btn btn-outline-primary">همه محصولات <i class="bi bi-arrow-left"></i></a>
            </div>
            <div class="row g-4">
                @foreach (var p in data.Products.Take(4))
                {
                    <div class="col-6 col-lg-3"><ProductCardView Product="p" /></div>
                }
            </div>
        </div>
    </section>
}

@if (data.Instructors.Count > 0)
{
    <section class="section">
        <div class="container">
            <h2 class="section-title text-center">مدرسین ما</h2>
            <p class="section-subtitle text-center">متخصصانی که تجربه واقعی خود را با شما به اشتراک می‌گذارند</p>
            <div class="row g-4 justify-content-center">
                @foreach (var i in data.Instructors)
                {
                    <div class="col-6 col-md-4 col-lg-3">
                        <div class="az-card instructor">
                            @if (!string.IsNullOrEmpty(i.PhotoPath)) { <img src="@i.PhotoPath" alt="@i.FullName" loading="lazy" width="96" height="96" /> }
                            else { <span class="avatar-fallback"><i class="bi bi-person"></i></span> }
                            <h3>@i.FullName</h3>
                            @if (!string.IsNullOrEmpty(i.Title)) { <p>@i.Title</p> }
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}

@if (data.Features.Count > 0)
{
    <section class="section section-white">
        <div class="container">
            <h2 class="section-title text-center">چرا دوره‌های ما؟</h2>
            <p class="section-subtitle text-center">آنچه شرکت در دوره‌های ما را متفاوت می‌کند</p>
            <div class="row g-4">
                @foreach (var f in data.Features)
                {
                    <div class="col-sm-6 col-lg-3">
                        <div class="feature">
                            <div class="icon"><i class="bi @f.Icon"></i></div>
                            <h3>@f.Title</h3>
                            @if (!string.IsNullOrEmpty(f.Description)) { <p>@f.Description</p> }
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}

@if (data.Faqs.Count > 0)
{
    <section class="section" id="faq">
        <div class="container" style="max-width:820px">
            <h2 class="section-title text-center">پرسش‌های متداول</h2>
            <p class="section-subtitle text-center">پاسخ سوالات رایج درباره ثبت‌نام و پرداخت</p>
            <div class="faq">
                @foreach (var q in data.Faqs)
                {
                    <details>
                        <summary>@q.Question</summary>
                        <div class="pre-line">@q.Answer</div>
                    </details>
                }
            </div>
        </div>
    </section>
}

<section class="section section-white" id="contact">
    <div class="container">
        <div class="row g-4 g-lg-5">
            <div class="col-lg-5">
                <h2 class="section-title">تماس با ما</h2>
                <p class="text-muted mb-4">برای مشاوره و اطلاعات بیشتر با ما در تماس باشید.</p>
                <ContactInfo Settings="s" />
            </div>
            <div class="col-lg-7">
                <div class="az-card p-4">
                    <h3 class="h5 mb-3">ارسال پیام</h3>
                    <ContactForm />
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private HomePageData? data;

    protected override async Task OnInitializedAsync() => data = await Catalog.GetHomeAsync();
}
