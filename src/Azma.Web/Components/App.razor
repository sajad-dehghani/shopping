<!DOCTYPE html>
<html lang="fa" dir="rtl" class="no-js">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#4f46e5" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="preload" href="@Assets["lib/vazirmatn/Vazirmatn-Variable.woff2"]" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.rtl.min.css"]" />
    <link rel="stylesheet" href="@Assets["lib/bootstrap-icons/bootstrap-icons.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Azma.Web.styles.css"]" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>

<body class="@(IsAdmin ? "admin-body" : "has-bottom-nav")">
    <Routes />
    @if (IsAdmin)
    {
        <ReconnectModal />
    }
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    @if (!IsAdmin)
    {
        <script src="@Assets["js/site.js"]"></script>
    }
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private bool IsAdmin => HttpContext.Request.Path.StartsWithSegments("/admin");
    // Public pages are static SSR (fast, no websocket). Only admin pages opt in to InteractiveServer.
}
